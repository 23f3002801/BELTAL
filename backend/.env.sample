# Copy to .env and fill in real values. .env is gitignored — never commit it.

PORT=4000

# Vite dev server origin allowed by CORS. Defaults to this value in src/config/env.js
# if unset, so this line is optional for local dev — set it explicitly in deployed envs.
FRONTEND_URL=http://localhost:5173

# Postgres connection string for the off-chain read-cache (see prisma/schema.prisma).
# Dev DB: create a free instance at https://neon.tech or https://supabase.com,
# then paste its connection string here. Must include ?sslmode=require for most
# hosted providers.
DATABASE_URL="postgresql://user:password@host:5432/beltal?sslmode=require"

# Read by src/config/env.js; not used elsewhere yet.
RPC_URL=
CONTRACT_ADDRESS=
JWT_SECRET=
IPFS_API_KEY=
