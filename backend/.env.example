# Security & Cryptography
JWT_SECRET="trustchain-secret-key-32chars-min-len"
JWT_EXPIRES_IN=24h
DOSSIER_ENCRYPTION_KEY="32_byte_hex_key_here"

# Pinata IPFS Vault
PINATA_JWT=""
PINATA_API_KEY=""
