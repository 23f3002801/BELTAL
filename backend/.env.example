NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# Ethereum Sepolia Blockchain
